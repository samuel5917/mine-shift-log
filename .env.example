# ==========================================================
# MINESHIFT - VARIÁVEIS DE AMBIENTE
# ==========================================================
# Copie este arquivo para ".env" e preencha com seus valores.
# Nunca faça commit do arquivo ".env" com chaves reais.

# ----------------------------------------------------------
# SUPABASE (obrigatório)
# ----------------------------------------------------------
# URL e chave pública do seu projeto Supabase.
# Estas variáveis (VITE_) ficam visíveis no navegador.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE

# Variáveis de servidor (não ficam no navegador).
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE

# Chave administrativa — NUNCA use VITE_ aqui.
# NUNCA exponda esta chave no navegador.
SUPABASE_SECRET_KEY=sb_secret_SUA_CHAVE

# ----------------------------------------------------------
# IA (opcional — para Assistente e Ata)
# ----------------------------------------------------------
# O provedor de IA é configurável. A aplicação suporta:
#   - openrouter (padrão)
#   Adicione mais provedores em src/lib/ai/provider.ts
#
# A API Key do usuário é salva por usuário no banco de dados,
# mas você pode definir um padrão aqui:

# AI_PROVIDER=openrouter
# AI_MODEL=openrouter/free

# Atribuição opcional para OpenRouter:
# AI_SITE_NAME=MineShift
# AI_SITE_URL=https://seu-dominio.com

# ----------------------------------------------------------
# MONITORAMENTO DE RAIOS (opcional)
# ----------------------------------------------------------
# WarPulse Lightning API para o painel de Clima.
# Obtenha sua chave em https://api.warpulse.com

# WARPULSE_API_KEY=
